{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UpstreamApi": {
    "BaseUrl": "https://api-assessment-biopharma.kalbe.co.id",
    "AuthPath": "/api/v1/authentication",
    "FeaturePath": "/api/v1/feature",
    "AppId": "",
    "AppKey": "",
    "AppCode": "ASSESSMENT",
    "ModuleCode": "ALL",
    "TimeoutSeconds": 30
  },
  "SessionCookies": {
    "Secure": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "FileLogging": {
    "Directory": "logs",
    "MinimumLevel": "Information",
    "RetainedDays": 14
  },
  "AuditTrail": {
    "FilePath": "data/audit-trail.jsonl"
  }
}
